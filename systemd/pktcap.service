[Unit]
Description=mitm-ctl 网页控制台 / 解密内容查看
Documentation=https://github.com/ajxdp/mitm-ctl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/pktcap/pktcap_server.py
Environment=PKTCAP_IFACE=__LAN_IF__
Environment=PKTCAP_PORT=__PORT__
Environment=PKTCAP_USER=__USER__
Environment=PKTCAP_PASS=__PASS__
Environment=MITM_CONF=__CONF__
Environment=MITM_BLOB_DIR=/tmp/mitm-blobs
Environment=PKTCAP_BODYLOG=/tmp/mitm-body.jsonl
Restart=always
RestartSec=5
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pktcap

[Install]
WantedBy=multi-user.target
