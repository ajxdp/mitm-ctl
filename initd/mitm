#!/bin/sh /etc/rc.common
# mitm-ctl 解密代理（OpenWrt procd 服务）
USE_PROCD=1
START=91
STOP=11

# 清掉可能残留的旧实例。
# 为什么需要：procd 的记账和实际情况可能脱节（比如进程曾被直接 kill、或上一轮
# 重启时旧进程还没退出），此时新实例会 bind 失败并进入 crash loop
# （日志里的 OSError: [Errno 98] Address in use），流量却仍被那个失控的旧进程处理。
kill_stale() {
	_k=0
	for d in /proc/[0-9]*; do
		c=$(cat "$d/comm" 2>/dev/null) || continue
		[ "$c" = "python3" ] || continue
		tr '\0' ' ' < "$d/cmdline" 2>/dev/null | grep -q "$1" && {
			kill "$(basename "$d")" 2>/dev/null
			_k=1
		}
	done
	[ "$_k" = "1" ] && sleep 1
	return 0
}

start_service() {
	kill_stale mitm_proxy.py
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/share/mitm/mitm_proxy.py
	procd_set_param env MITM_CONF=__CONF__ MITM_CERT_DIR=/tmp/mitm-certs MITM_BLOB_DIR=/tmp/mitm-blobs
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# 仅在「透明模式」下才下发重定向规则
	[ -f /etc/mitm/tproxy ] && /usr/libexec/mitm-nft.sh apply
	return 0
}

stop_service() {
	/usr/libexec/mitm-nft.sh clear
	return 0
}
